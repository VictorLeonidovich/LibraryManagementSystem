<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Import Spring Boot default console appender settings -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Bind log directory and file name to Spring environment properties -->
    <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="./logs" />
    <springProperty scope="context" name="LOG_FILE" source="logging.file.name" defaultValue="library-system" />

    <!-- Console Appender (Colorized using Spring Boot default pattern) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Project Package Logging Levels -->
    <logger name="com.kvl.library" level="DEBUG" />

    <!-- Profile Specific Configurations for local development and testing -->
    <springProfile name="dev, test, containers">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- Profile Specific Configurations for production environment -->
    <springProfile name="prod">
        <!-- Rolling File Appender is initialized ONLY in prod profile to prevent initialization warnings -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${LOG_FILE}.log</file>
            <encoder>
                <!-- Fixed pattern for seamless Logstash parsing: Timestamp | Level | PID | Thread | Logger | Message -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | ${PID:- } | [%thread] | %logger{36} | %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>3GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <logger name="org.hibernate.SQL" level="WARN" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- Default Fallback Root Configuration (Fixes the warnings if no profile matches) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>